# Cổng lắng nghe của Backend
PORT=3001

# Chuỗi kết nối MongoDB (Atlas hoặc local). Điền giá trị thật vào file .env, không commit file đó.
# Ví dụ Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/it4409_rbac
# Ví dụ local : mongodb://127.0.0.1:27017/it4409_rbac
MONGODB_URI=

# Chuỗi bí mật dùng để ký JWT. Đặt chuỗi ngẫu nhiên dài, khác nhau giữa local và host.
JWT_SECRET=

# Thời hạn access token, đơn vị giây
ACCESS_TOKEN_TTL=3600

# Danh sách origin của Frontend được phép gọi API, phân tách bằng dấu phẩy, không có dấu gạch chéo cuối
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Số lần đăng nhập sai tối đa trong một cửa sổ thời gian trước khi trả 429 (tùy chọn)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Đặt true nếu muốn Backend phục vụ luôn thư mục frontend (triển khai một dịch vụ duy nhất)
SERVE_FRONTEND=false
